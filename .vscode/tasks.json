// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$tsc-watch",
				"$tsc",
				"$eslint-compact",
				"$eslint-stylish",
				{
					"owner": "esbuild",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^✘ \\[ERROR\\] (.*?)$",
						"message": 1
					}
				}
			],
			"isBackground": false,
			"label": "npm: compile",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		}
	]
}
